# URL base de auth-service (valida los tokens via GET /auth/session)
REPORTS_AUTH_SERVICE_URL=http://localhost:8000
# URL base de transactions-service (consulta gastos via GET /transactions)
REPORTS_TRANSACTIONS_SERVICE_URL=http://localhost:8001
# URL base de budgets-service (consulta presupuestos via GET /budgets)
REPORTS_BUDGETS_SERVICE_URL=http://localhost:8002
REPORTS_DATABASE_URL=sqlite:///./reports.db
# Directorio local donde se almacenan los archivos JSON y CSV generados
REPORTS_STORAGE_DIR=./generated_reports
